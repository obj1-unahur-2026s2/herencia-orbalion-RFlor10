import orbalion.*

describe "Test CHECK POINT 1"{
    test  "Un entrenador no puede tener tener un rol distinto a los autorizados por la FOZ."{
        assert.throwsExceptionLike(
            new Exception (
                message = "Rol no homologado por la FOZ"),
            { new Entrenador (ciclosDeExperiencia = 25,
                              estaEnSintonia = true,
                              nivelDePresicion = 25,
                              rol = "Entrenador fisico")}
        )
    }
}

describe "Test CHECK POINT 1.2"{
    test "Un equipo lumínico con radiación > 5000 y sin tecnologías activas → su energía total es su energía base."{
        const lumi = new Luminicos (nombre = "Lumi" ,
                                        nivelDeEnergiaBase = 100 ,
                                        //instancio un entrenador para la constante entrenador
                                        entrenador = new Entrenador(
                                            ciclosDeExperiencia = 25,
                                            estaEnSintonia = true,
                                            nivelDePresicion = 25,
                                            rol = "Estratega Cuántico"
                                            ),
                                        nivelDeRadiacionCapturada = 10000     
                                        )
        assert.equals(100, lumi.energiaTotal())         
                          
    }
}
describe "Test CHECK POINT 1.3"{
    test "Un equipo lumínico con radiación < 5000 → obtiene el bono del 10%"{
        const lumi = new Luminicos (nombre = "Lumi" ,
                                        nivelDeEnergiaBase = 100 ,
                                        //instancio un entrenador para la constante entrenador
                                        entrenador = new Entrenador(
                                            ciclosDeExperiencia = 25,
                                            estaEnSintonia = true,
                                            nivelDePresicion = 25,
                                            rol = "Estratega Cuántico"
                                            ),
                                        nivelDeRadiacionCapturada = 4000     
                                        )
        assert.equals(110, lumi.energiaTotal())                                
    }
}

describe "Test CHECK POINT 1.4"{
    test "Un equipo sintético con 6 módulos → aplica correctamente la penalización del 20%."{
        const sint = new Sinteticos (nombre = "Sint",
                                     nivelDeEnergiaBase = 1000,
                                     entrenador = new Entrenador(
                                            ciclosDeExperiencia = 25 ,
                                            estaEnSintonia = true ,
                                            nivelDePresicion = 25 ,
                                            rol = "Estratega Cuántico"
                                            ) ,
                                            nivelDeProcesamientoCentral = 10 ,
                                            cantidadDeModulosActivos = 6 )
        assert.equals(800, sint.energiaTotal())
    }
}

describe "Test CHECK POINT 1.5"{
    test " Un equipo sintético con 4 módulos y 2 tecnologías complementarias → suma correctamente los valores energéticos."{
        const synth = new Sinteticos ( nombre = "Synth", 
                                       nivelDeEnergiaBase = 1000, 
                                            entrenador = new Entrenador(
                                            ciclosDeExperiencia = 30 ,
                                            estaEnSintonia = true ,
                                            nivelDePresicion = 30 ,
                                            rol = "Estratega Cuántico"
                                            )  ,
                                            nivelDeProcesamientoCentral = 10 , 
                                            cantidadDeModulosActivos = 4,
                                            tecnologiasComplementarias = [new TecnologiasEspeciales(
                                                nombre = "laser" , 
                                                valorEnergetico = 10,
                                                activa = true
                                            ),
                                            new TecnologiasEspeciales(
                                                nombre = "rayo" , 
                                                valorEnergetico = 10,
                                                activa = true)]
                                       )
            assert.equals(4, synth.cantidadDeModulosActivos()) 
            assert.equals(2,synth.cantTecnologiasComplementariasActivas()) 
            assert.equals(20, synth.energiaDeTecnologiasActivas())                         

    }
}


describe "Test CHECK POINT 2"{
    test "Estratega cuántico con 12 ciclos y precisión 90 → es de élite galáctica"{
        const estrategaCuantico = new Entrenador(ciclosDeExperiencia = 12,
                                                estaEnSintonia = true ,
                                                nivelDePresicion = 90 ,
                                                rol = "Estratega Cuántico"
                                                )
        assert.that(estrategaCuantico.esDeEliteGalactico())  
    }
}
describe "Test CHECK POINT 2.1"{
    test "Arquitecto de energía con 11 ciclos pero sin sintonía → no es de élite."{
        const arquitecto = new Entrenador(ciclosDeExperiencia = 11,
                                          estaEnSintonia = false,
                                          nivelDePresicion = 100,
                                          rol = "Arquitecto de Energía"
                                           )
    assert.notThat(arquitecto.esDeEliteGalactico())
    }
}
describe "Test CHECK POINT 2.2"{
    test "Guía mental con 15 ciclos → siempre es de élite."{
        const guia = new Entrenador (ciclosDeExperiencia = 15 ,
                                     estaEnSintonia = true,
                                     nivelDePresicion = 90,
                                     rol = "Guía Mental")
    assert.that(guia.esDeEliteGalactico())                                 
    }
}